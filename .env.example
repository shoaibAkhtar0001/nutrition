# Copy to .env (git-ignored) and fill in. Never commit real keys.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Kolkata

# Optional legacy integrations (rotate any keys that were previously committed!)
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=
EXERCISEDB_API_KEY=

# Gemini AI provider configuration
# Set a real key for live AI answers; the demo value keeps local setup working.
GEMINI_API_KEY=demo-key-for-local-dev
GEMINI_MODEL=gemini-2.5-flash

# AI provider (optional). Without these the app runs in clearly-labelled demo mode.
AI_PROVIDER=gemini
ANTHROPIC_API_KEY=
